# Copy this file to .env and fill in your real Postgres connection string.
# Get one for free from Neon (neon.tech), Supabase (supabase.com), or Railway.
#
# If your provider gives you a pooled AND a direct URL (Neon/Supabase do),
# use the pooled one here for serverless deployments (Vercel etc.):
DATABASE_URL="postgresql://user:password@host:5432/hisabkitab?schema=public"
